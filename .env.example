# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API Keys for TTS Services
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
KOKORO_API_KEY=your_kokoro_api_key_here

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Default TTS Provider (openai, openrouter, or kokoro)
DEFAULT_TTS_PROVIDER=openai

# OpenAI TTS Configuration
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Kokoro API Configuration
KOKORO_API_URL=https://api.kokoro.ai/v1/tts
KOKORO_VOICE=en-us-1

# OpenRouter TTS Configuration (if they provide TTS)
OPENROUTER_TTS_MODEL=your_model_here
